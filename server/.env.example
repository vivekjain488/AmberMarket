# Required for on-chain oracle transactions
ORACLE_PRIVATE_KEY=your_oracle_wallet_private_key

# CORS: comma-separated allowed origins (Vercel prod + preview + local)
CLIENT_ORIGIN=http://localhost:5173

# Sepolia (optional)
SEPOLIA_RPC=https://1rpc.io/sepolia
SEPOLIA_CONTRACT_ADDRESS=your_deployed_market_address
SEPOLIA_AMBER_TOKEN_ADDRESS=your_deployed_token_address
SEPOLIA_JUNCTION_REGISTRY_ADDRESS=your_deployed_registry_address
SEPOLIA_JUNCTION_NFT_ADDRESS=your_deployed_nft_address

# Base Sepolia (recommended)
BASE_SEPOLIA_RPC=https://sepolia.base.org
BASE_SEPOLIA_CONTRACT_ADDRESS=your_deployed_base_market_address
BASE_SEPOLIA_AMBER_TOKEN_ADDRESS=your_deployed_base_token_address
BASE_SEPOLIA_JUNCTION_REGISTRY_ADDRESS=your_deployed_base_registry_address
BASE_SEPOLIA_JUNCTION_NFT_ADDRESS=your_deployed_base_nft_address

# CV oracle runtime settings
ENABLE_CV_ORACLE=true
PYTHON_EXECUTABLE=python

# ENS Subdomain Registration (get key from https://app.namespace.ninja)
NAMESPACE_API_KEY=your_namespace_developer_key
ENS_PARENT_NAME=ambermarket.eth
ETH_MAINNET_RPC=https://ethereum-rpc.publicnode.com

# Basic runtime settings
PORT=3001
PLATFORM_FEE_BPS=300
YOUTUBE_STREAM_URL=https://www.youtube.com/watch?v=ydYDqZQpim8
